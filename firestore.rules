rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /games/{gameId}/events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && eventId.matches(request.auth.uid + '-[0-9]{6}')
        && request.resource.data.keys().hasOnly([
          'type',
          'payload',
          'actorUid',
          'clientSeq',
          'createdAt',
          'schemaVersion',
          'reducerVersion'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.clientSeq is int
        && request.resource.data.clientSeq > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.schemaVersion == 1
        && request.resource.data.reducerVersion == 'room-v1'
        && request.resource.data.type in [
          'game/created',
          'player/joined',
          'race/configured',
          'player/ready',
          'program/submitted',
          'program/timed-out',
          'effect/chosen',
          'game/rematched',
          'power-down/responded'
        ]
        && request.resource.data.payload is map
        && (
          (
            request.resource.data.type == 'game/created'
            && request.resource.data.payload.hostUid == request.auth.uid
            && request.resource.data.payload.gameId == gameId
          )
          ||
          (
            request.resource.data.type == 'player/joined'
            && request.resource.data.payload.uid == request.auth.uid
          )
          ||
          (
            request.resource.data.type == 'race/configured'
            && request.resource.data.payload.config is map
            && request.resource.data.payload.config.editionId == 'avalon-hill-2005'
            && request.resource.data.payload.config.courseId in [
              'risky-exchange',
              'factory-rejects',
              'option-world'
            ]
          )
          ||
          (
            request.resource.data.type == 'player/ready'
            && request.resource.data.payload.uid == request.auth.uid
            && request.resource.data.payload.configurationEventId is string
          )
          ||
          (
            request.resource.data.type == 'program/submitted'
            && request.resource.data.payload.uid == request.auth.uid
            && request.resource.data.payload.turnId.matches('turn-[0-9]+')
            && request.resource.data.payload.cardIds is list
          )
          ||
          (
            request.resource.data.type == 'program/timed-out'
            && request.resource.data.payload.targetUid is string
            && request.resource.data.payload.turnId.matches('turn-[0-9]+')
            && request.resource.data.payload.cardIds is list
            && (
              request.resource.data.payload.targetUid == request.auth.uid
              || request.resource.data.payload.cardIds.size() == 0
            )
          )
          ||
          (
            request.resource.data.type == 'effect/chosen'
            && request.resource.data.payload.uid == request.auth.uid
            && request.resource.data.payload.turnId.matches('turn-[0-9]+')
            && request.resource.data.payload.choice is map
            && (
              (
                request.resource.data.payload.choice.kind == 'reentry'
                && request.resource.data.payload.choice.x is int
                && request.resource.data.payload.choice.y is int
                && request.resource.data.payload.choice.facing in [
                  'north',
                  'east',
                  'south',
                  'west'
                ]
              )
              ||
              (
                request.resource.data.payload.choice.kind == 'option-loss'
                && request.resource.data.payload.choice.cardId is string
              )
              ||
              (
                request.resource.data.payload.choice.kind == 'option-plan'
                && request.resource.data.payload.choice.preventDamageWith is list
                && request.resource.data.payload.choice.activations is list
              )
            )
          )
          ||
          (
            request.resource.data.type == 'game/rematched'
            && request.resource.data.payload.epoch is int
            && request.resource.data.payload.epoch > 1
            && request.resource.data.payload.seed is string
          )
          ||
          (
            request.resource.data.type == 'power-down/responded'
            && request.resource.data.payload.uid == request.auth.uid
            && request.resource.data.payload.turnId.matches('turn-[0-9]+')
            && request.resource.data.payload.powerDownNextTurn is bool
          )
        );
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
